{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the AIOS main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-get-runtime-status",
    "allow-start-runtime",
    "allow-stop-runtime",
    "allow-create-process",
    "allow-start-process",
    "allow-pause-process",
    "allow-resume-process",
    "allow-stop-process",
    "allow-get-projects",
    "allow-register-project",
    "allow-remove-project",
    "allow-set-active-project",
    "allow-refresh-projects",
    "allow-get-models",
    "allow-register-model-provider",
    "allow-remove-model-provider",
    "allow-register-model",
    "allow-remove-model",
    "allow-set-model-default",
    "allow-clear-model-default"
  ]
}
